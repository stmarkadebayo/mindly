# OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
WRITER_MODEL=google/gemma-4-26b-a4b-it
REFLECT_MODEL=google/gemma-4-26b-a4b-it
# OpenRouter only: use only providers that don't collect or train on your prompts (recommended for a journal).
LLM_DENY_DATA_COLLECTION=1

# STT fast path: a hosted Whisper endpoint. Groq (https://console.groq.com) serves whisper-large-v3-turbo.
ASR_API_KEY=
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo
# With no ASR_API_KEY, Whisper runs on this machine instead (pip install -r requirements-local-asr.txt).
# It is slower on a CPU. Sizes: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# --- Server (docker-compose.yml only) ---
# Your public domain, for example mindly.duckdns.org. Caddy gets an HTTPS certificate for it.
DOMAIN=

# --- Accounts ---
# Optional Google sign-in: an OAuth client ID of type "Web application" from Google Cloud Console.
# Add your site's origin (for example http://localhost:8001) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# AI requests (transcribe, write, talk) allowed per account per day. Protects your API budget.
DAILY_AI_LIMIT=300
# Where the account database lives. In production, point this at a persistent volume.
# DATA_DIR=/data
