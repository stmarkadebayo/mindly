# OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
WRITER_MODEL=google/gemma-4-26b-a4b-it
REFLECT_MODEL=google/gemma-4-26b-a4b-it
# If the main model keeps failing, try this one (same family, Apache 2.0). Leave empty for none.
LLM_FALLBACK_MODEL=google/gemma-4-31b-it
# OpenRouter only: use only providers that don't collect or train on your prompts (recommended for a journal).
LLM_DENY_DATA_COLLECTION=1

# STT fast path: a hosted Whisper endpoint. Groq (https://console.groq.com) serves whisper-large-v3-turbo.
ASR_API_KEY=
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo
# If the main speech model keeps failing, try this one (MIT). Leave empty for none.
ASR_FALLBACK_MODEL=whisper-large-v3
# Optional second engine for the header toggle (see scripts/naijavox_server.py):
# ASR_ALT_BASE_URL=http://127.0.0.1:9000/v1
# ASR_ALT_MODEL=NaijaVox-2.0
# For STORM-OS ASR instead: ASR_ALT_STYLE=storm, ASR_ALT_BASE_URL=http://34.228.222.150:8000, ASR_ALT_API_KEY=..., ASR_ALT_LABEL=STORM
# With no ASR_API_KEY, Whisper runs on this machine instead (pip install -r requirements-local-asr.txt).
# It is slower on a CPU. Sizes: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# --- Server (docker-compose.yml only) ---
# Your public domain, for example mindly.duckdns.org. Caddy gets an HTTPS certificate for it.
DOMAIN=

# --- Accounts ---
# Optional Google sign-in: an OAuth client ID of type "Web application" from Google Cloud Console.
# Add your site's origin (for example http://localhost:8001) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# AI requests (transcribe, write, talk) allowed per account per day. Protects your API budget.
DAILY_AI_LIMIT=300
# Where the account database lives. In production, point this at a persistent volume.
# DATA_DIR=/data

# --- Plans ---
# Everyone starts with a 30-day Pro trial. After it, free accounts get this many seconds of speech a day.
# FREE_DAILY_SECONDS=600
# PRO_PRICE_LABEL=$7/month
# Paystack subscription (leave empty to hide the upgrade button). In the Paystack dashboard: create a monthly Plan, copy its
# plan code, and set the webhook URL to https://YOUR-DOMAIN/api/billing/webhook (Settings, API Keys & Webhooks).
# PAYSTACK_SECRET_KEY=sk_live_...   (sk_test_... while testing; it also signs the webhooks)
# PAYSTACK_PLAN_CODE=PLN_...
# PAYSTACK_AMOUNT=700000            (the plan's price in kobo or cents; must match the plan)
